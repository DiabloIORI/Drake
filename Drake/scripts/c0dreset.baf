
IF 
    True() 
THEN 
    RESPONSE #100    
        CutSceneId("C0Drake")          
        SetName(~Drake~)
        SetPlayerSound(Myself,~跟这家伙再打下去没道理了！~ [C0DR001],MORALE) 
        SetPlayerSound(Myself,~不错，不错。你够跟任何骑士较量的。~ [C0DR002],HAPPY) 
        SetPlayerSound(Myself,~这回我先往好处想，可你自己当心。~ [C0DR003],UNHAPPY_ANNOYED)
        SetPlayerSound(Myself,~你要么是糊涂得没救了，要么是烂得没救了。我祈祷你是前者。~ [C0DR004],UNHAPPY_SERIOUS)
        SetPlayerSound(Myself,~够了。我得喝不止几杯才能忘掉我看到的。下回再见，我先动锤子。~ [C0DR005],UNHAPPY_BREAKING_POINT)
        SetPlayerSound(Myself,~这事你问错人了。认真的？你最好别后悔。~ [C0DR006],LEADER)
        SetPlayerSound(Myself,~这会儿我还有什么不肯换个烈酒和软床的……~ [C0DR007],TIRED)
        SetPlayerSound(Myself,~我快憋尿憋出来了，跟当年在骑士团当班站桩一样。我们能不能走快些？~ [C0DR008],BORED)
        SetPlayerSound(Myself,~我要亲手把你送上审判！~ [C0DR009],BATTLE_CRY1) 
        SetPlayerSound(Myself,~你不过是个还在走路的死人！~ [C0DR010],BATTLE_CRY2) 
        SetPlayerSound(Myself,~趁还能，把祷词念了吧！~ [C0DR011],BATTLE_CRY3)      
        SetPlayerSound(Myself,~这杯算我的！~ [C0DR012],BATTLE_CRY4) 
        SetPlayerSound(Myself,~我的锤子等着亲你屁股！~ [C0DR013],BATTLE_CRY5)   
        SetPlayerSound(Myself,~哎哟！~ [C0DR014],DAMAGE)
        SetPlayerSound(Myself,~呃……该死……~ [C0DR015],DYING)
        SetPlayerSound(Myself,~啊……你就这点本事？~ [C0DR016],HURT)
        SetPlayerSound(Myself,~早知道要在林子里跋涉，我就该穿双结实点的靴子。~ [C0DR017],AREA_FOREST)
        SetPlayerSound(Myself,~小贩、臭气、便宜麦酒。正合我意。~ [C0DR018],AREA_CITY)
        SetPlayerSound(Myself,~脚下留神。傻子才冲进天使都不敢踏的地方。~ [C0DR019],AREA_DUNGEON)
        SetPlayerSound(Myself,~太阳照在我们头顶，我又想起我的铠甲还得擦。~ [C0DR020],AREA_DAY)
        SetPlayerSound(Myself,~我们本可以在暖和的旅店里喝醉，而不是在黑暗里笨重地走……~ [C0DR021],AREA_NIGHT)
        SetPlayerSound(Myself,~嗯？~ [C0DR022],SELECT_COMMON1)
        SetPlayerSound(Myself,~有事吗？~ [C0DR023],SELECT_COMMON2)
        SetPlayerSound(Myself,~下命令吧。~ [C0DR024],SELECT_COMMON3)
        SetPlayerSound(Myself,~当然，当然。~ [C0DR028],SELECT_ACTION1)
        SetPlayerSound(Myself,~简单得很。~ [C0DR029],SELECT_ACTION2)
        SetPlayerSound(Myself,~我们走。~ [C0DR030],SELECT_ACTION3)
        SetPlayerSound(Myself,~哈！看来天平偏*我*这边！~ [C0DR037],CRITICAL_HIT)
        SetPlayerSound(Myself,~啧……没人看见。~ [C0DR038],CRITICAL_MISS)
        SetPlayerSound(Myself,~没效果？这可没料到。~ [C0DR039],TARGET_IMMUNE)
        SetPlayerSound(Myself,~这破烂我得有两只以上的手才拿得住。找别人去搬。~ [C0DR040],INVENTORY_FULL)
        SetPlayerSound(Myself,~该死的！~ [C0DR041],SPELL_DISRUPTED)
        SetPlayerSound(Myself,~我同情那踩上这玩意儿的可怜混蛋。~ [C0DR042],SET_A_TRAP)
        SetPlayerSound(Myself,~该试试潜行了。~ [C0DR043],HIDDEN_IN_SHADOWS)
        SetPlayerSound(Myself,~不太像骑士，可没人需要知道，对吧？~ [C0DR044],PICKED_POCKET)
        SetPlayerSound(Myself,~有人问起德雷克的过去时，他讥讽地笑一声，回答说要是他的过去被忘掉，历史会呼吸得更顺畅。他是提尔的祭司，三十五六岁，考尔菲尔德家次子，曾是安姆民兵的少尉，说起来还带着一丝自嘲地补充，是光辉之心辅助队的新募。他自认在骑士团里是“他们甩不掉的那号东西”。他坦承自己对骑士团教条和正义分配的非正统看法，让他成了光辉之心同袍和家里人眼里的社会弃儿，而他家人几乎个个都有在骑士团服役的履历。据他说，他驻在安姆之外，官方说法是去铲除祸害剑湾的邪恶，可他相信那不过是把他打发走、让上司忘掉他的正式手段。不过这样的差事似乎正合他意，因为他相信正义最好用刀刃来施行——或者，在他这儿，用锤头。~,EXISTANCE5)
        EndCutSceneMode()
		StartDialogueNoSet(Player1)
END 