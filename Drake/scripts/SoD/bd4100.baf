IF
  Global("bd_plot","global",591)
  !GlobalTimerNotExpired("bd_mdd1352_ot_timer","bd4100")
  Global("bd_C0Drake_ot","bd4100",0)
  ReputationLT(Player1,10)
  InParty("C0Drake")
THEN
  RESPONSE #100
    SetGlobal("bd_C0Drake_ot","bd4100",1)
  RESPONSE #100
    SetGlobal("bd_C0Drake_ot","bd4100",1)
    SetGlobalTimer("bd_mdd1352_ot_timer","bd4100",ONE_ROUND)
    DisplayStringHead("C0Drake",~唉……我没想到事情会糟到这份上。看来我就是那个傻子。~)
END

