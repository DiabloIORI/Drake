	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeKhalid2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~我看你说得比谁都透，卡立德。我们俩都不把自己当战士……我们对战斗和杀戮没兴趣。对我们来说，要打是别的东西驱着的。职责、忠诚，或者别的什么……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeKhalid2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Khalid",~你——你为什么而战，德雷克？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeKhalid2","MYAREA",50)
RESPONSE #50
