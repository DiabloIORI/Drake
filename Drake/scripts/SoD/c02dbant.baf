	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeViconia2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~说来好笑，维康尼亚，我还真感激。你难得夸我一回，这……不像你。也许这是说，我上回做饭有长进？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeViconia2","MYAREA",40)
