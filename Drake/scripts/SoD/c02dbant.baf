// SIRENE

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeSirene1","MYAREA",0)
	Switch("C02DrakeSirene1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~你看着累了，慈悲女士。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~是。近来我难得安歇。打的仗太多，流过的血还留在我脑子里。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~战争的担子对你这种人实在不合身。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~也许吧。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~可你还是会留下？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~如果我不把个人感受放到一边、选择永远当旁观者，那就什么都不会变。会有更多人受苦、死去。我不是想打仗，可我不打，我活着的每一刻都会被愧疚缠着。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Drake",~我不能说我羡慕伊尔玛塔信徒的责任。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeSirene2","MYAREA",0)
	Switch("C02DrakeSirene2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Sirene",~你是祭司，德雷克，可我从未见你祈祷。能问问为什么吗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~我有时替别人祈祷。可通常只在他们来找我要几句宽慰话时。我不为自己祈祷。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Sirene",~祈祷不能给你安慰？不能让你听到你的主神提尔的声音，就像我祈祷时伊尔玛塔回应我那样？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~祈祷的价值只跟你信它多少一样。我什么都见过。人们求财富、安逸、平安、幸福……他们要神解决他们所有问题，回答他们所有疑问。这对谁真管用过？对你管用过？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Sirene",~我不知道。可我知道，当我感觉自己得了回应时，它确实给了我几分平静。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeSirene2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Drake",~是，要真管用，那你就更该如此，慈悲女士。我不是那种坐着等答案的人。提尔要觉得该给我什么，不管是力量还是指引，我就谢他，以他之名用它。可我更愿信我自己的本事，胜过一切……连神也算上。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeSirene2","MYAREA",-1)
END

