	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~不必喊，我还没聋……不过照这么下去快了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Neera",~对——对不起！呃，我是说，抱歉。我只是想问问——*清嗓* 你能不能把这该死的声音从我脑里驱——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~是，是，我明白。可惜，我的答案是不行。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Neera",~为什么？为什么呀呀？要是我好好求你行不行？求——求你啦？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Drake",~别误会，我也想要点清静。可事情不是那么办的。如果我知道是死魂缠着你，那也许……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Neera",~喂，这我能帮上？等一会儿，我得问一句。喂，阿多伊！你是活的还是死的？！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Neera",~……哦，好极了。现在他倒对我沉默了。呃呃呃！我去那边待一会儿。他很快就回来。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Drake",~你去吧。想待多久就待多久。越久越好。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeNeera1","MYAREA",-1)
END

