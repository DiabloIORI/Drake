// BAELOTH

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeBaeloth1","MYAREA",0)
	Switch("C02DrakeBaeloth1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Baeloth",~离我远点，你这永远虔诚、浑身带刺、头发像豪猪的祭司蠢货！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeBaeloth1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~头发像豪猪？这话伤人，贝洛斯。我得让你知道，我对我的头发很敏感。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeBaeloth1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Baeloth",~你的敏感对我而言，跟你们其余地表人那些精神上的苦恼一样刺激。惊人之无足轻重。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeBaeloth1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~众神在上，跟你说话比追踪神学家的思路还乏味。我就省下这头痛了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeBaeloth1","MYAREA",-1)
END

// CORWIN

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeCorwin1","MYAREA",0)
	Switch("C02DrakeCorwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~我感觉你不怎么喜欢我，队长。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("CORWIN",~你怎么这么想？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~没什么具体证据，可人不受欢迎的时候，不难察觉。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("CORWIN",~嗯，也许你说得对，就一点点。你身上有样东西我不喜欢——不，不是因为你是安姆人。我没那种偏见。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~那是什么？不介意我问吧。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("CORWIN",~别往坏处想，可你……听说你在世上最可敬的善之势力里有一席之地，还有个疼你的贵族家庭。我说错了？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeCorwin1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Drake",~两样都对。我家人彼此很顾惜，骑士团也可敬，可敬得过头了些。我两样都挺喜欢。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("CORWIN",~那你为什么在这儿？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeCorwin1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Drake",~确实为什么？这答案我自己都怀疑。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",90)
RESPONSE #90
	DisplayStringHead("CORWIN",~你要真因为想做点好事而来，那我敬重你。可要不是……你对家庭和安姆都有责任，可我总觉得你来这儿只为图个乐。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",8)
	SetGlobal("C02DrakeCorwin1","MYAREA",100)
RESPONSE #100
	DisplayStringHead("C0Drake",~你话里也许有些道理，队长，可从大局看，我既来帮忙，理由真那么要紧？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",110)
RESPONSE #110
	DisplayStringHead("CORWIN",~不，我看不要紧。可要我在你这位置……我大概不会来。我要说的就这些。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeCorwin2","MYAREA",0)
	Switch("C02DrakeCorwin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~你打过仗吗，队长？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("CORWIN",~我们眼下就在打。这不算？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~不，我是说*身陷*一场战争。我看你没尝过跟同袍一起在前线厮杀的滋味。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("CORWIN",~不，我看没有。你想说什么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~我们踏进战场时都怕失去什么，队长。也许是家人、家，或者性命。这是我们当兵的多少都接受了的。你自己能这么说吗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("CORWIN",~你觉得我是懦夫？因为我停不下想我家人？想我女儿，她这些天里哪天都可能没了母亲？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Drake",~我不这么想。我只是觉得你该有人提醒一句。你好像需要。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeCorwin2","MYAREA",-1)
END

// DORN

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeDorn1","MYAREA",0)
	Switch("C02DrakeDorn1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~你知道，对一个卖了灵魂的人，我还以为你会更气派些。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDorn1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Dorn",~什么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02DrakeDorn1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~我结巴了？哦，等等，我忘了。你脑子里的魔鬼声音无疑把我的轻柔语调盖住了。无妨，我只是在琢磨。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeDorn1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Dorn",~你走在细线上，祭司。我警告你，我的耐心非常、非常有限。惹我可是极不明智。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDorn1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~那你要怎样，多恩？当场杀我？我们都知道你不会。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDorn1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Dorn",~也许还不会。我不忘轻慢——也不宽恕。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDorn1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeDorn2","MYAREA",0)
	Switch("C02DrakeDorn2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dorn",~你怕死吗，祭司？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDorn2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~这是威胁？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDorn2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dorn",~也许是好奇。最近我想到……像你这样声称死后在神那里有位置的，会不会惧怕生命终结的那一刻？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeDorn2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Dorn",~还是你热切地等着它，指望你盲信的回报？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeDorn2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~嗯，我确实在想。我看我怕，也许。每个人都会，至少我这么信，那些说不会的是在骗自己。人人都怕死，哪怕只有一点。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeDorn2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Dorn",~愚蠢的信念。只有弱者才怕死，而你自己的话已经证明了这点。你要信死该怕，那你跟你抱着的那个信仰一样一文不值。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeDorn2","MYAREA",-1)
END

// DYNAHEIR

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeDynaheir1","MYAREA",0)
	Switch("C02DrakeDynaheir1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~你那位朋友明斯克是独一无二的，女士。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Dynaheir",~这……算是你说得宽厚了。多数人没这么客气。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~我没说那是坏事。他剑臂好，品行也过得去。还给我们这阴沉队伍添了点活气，你不觉得？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Dynaheir",~明斯克头脑简单，可他心是真的，我敬重他。我希望你也同样待他。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~别担心，女士。我对那大块头敬重得很。比我对许多人都多。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeDynaheir2","MYAREA",0)
	Switch("C02DrakeDynaheir2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dynaheir",~你对我们的首领<CHARNAME>极为敬重。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~这是陈述还是提问？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dynaheir",~是观察。我注意到你不轻易敬重人，可你对<CHARNAME>的忠心，就像明斯克对我一样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~你说得有理。<CHARNAME>至少算……有意思。我很好奇<PRO_HESHE>能走多远。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Dynaheir",~我也是，德雷克。我们很快就会看到我们这位好首领把我们带往何处。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeDynaheir2","MYAREA",-1)
END

// EDWIN

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeEdwin1","MYAREA",0)
	Switch("C02DrakeEdwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~你作弊，塞尔人。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02DrakeEdwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Edwin",~什么？！你竟敢用这种荒唐的暗示诽谤我！（他怎么知道的？他一定是在唬人！）~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~我会数牌。从你上回一怒烧了我的牌堆起，我一直发牌，我知道我没发给你六张。那一张是你凭空召出来的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Edwin",~谎话。谎话！你是在拖延你在我手下的必败！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02DrakeEdwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~我是说，埃德温，真的？我们赌的不过三十金币和最后一瓶长青蜜酒，值吗？你不至于这么吝啬。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Edwin",~红袍巫师的尊严，比你那空脑袋能装的要多得多，你这猴子！你以为我会让名声沾上败给你这种东西的耻辱？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeEdwin1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Drake",~你还有名声？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02DrakeEdwin1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Edwin",~啊啊！三十金币对塞尔一位尊贵的巫师算什么？拿去你的钱和你那外地酒，噎死吧！谁也没赢！我不玩了！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",8)
	SetGlobal("C02DrakeEdwin1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Drake",~我看你只是不想输。我随时愿意再来一局，朋友。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02DrakeEdwin1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeEdwin2","MYAREA",0)
	Switch("C02DrakeEdwin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Edwin",~我一直在琢磨我们那局没下完的棋，祭司。我看我想明白了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~我猜*不是*你眼看要输、就作弊想保面子那件事。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Edwin",~我承认我绝望之下用了些……手段。可作弊的是你！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~……再说一遍？我完全不知道你在说什么。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Edwin",~是吗？那你解释解释，你怎么能把每一步都算得那么准，像能读我的心一样！你否认有神力插手？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Drake",~*叹息* 不，埃德温。我没作弊。也许我利用了你露的马脚，可那都是棋局的一部分。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Edwin",~马脚？什么马脚？马上给我说清楚！我不留任何可被利用的弱点！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Drake",~你是个聪明人，埃德温，我承认。可你太怕失去哪怕一丁点优势。你拿到好牌，脸上的表情就露出来了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Drake",~你拿到坏牌，就抖得像节食的黑莲瘾者。你的眼皮开始颤。你自言自语……其实你平时也这样，可我说远了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",90)
RESPONSE #90
	DisplayStringHead("C0Drake",~我想说的是：你把一切都告诉了对手。大概这就是你在老家虽有力量却始终没混出头的缘故。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",100)
RESPONSE #100
	DisplayStringHead("Edwin",~安——安静！你对我在塞尔的地位一无所知，祭司。你今天犯了大错……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",110)
RESPONSE #110
	DisplayStringHead("Edwin",~我保证再不给你留什么可趁的“马脚”。下回我们赌，你会求我饶你！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",120)
RESPONSE #120
	DisplayStringHead("C0Drake",~当然，你说什么都行。毕竟像我这样的圣人绝不会作弊……对吧？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeEdwin2","MYAREA",-1)
END

// GLINT

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeGlint1","MYAREA",0)
	Switch("C02DrakeGlint1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~听说过詹森家吗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeGlint1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Glint",~詹森，嗯？我记得我有个表亲跟他们沾亲。你问这个做什么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeGlint1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~他们在老家阿斯卡特拉做挺出名的买卖。以前老有侏儒敲我们家门，想用离谱的价卖我们萝卜和小玩意。你家族不干那种买卖吧？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeGlint1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Glint",~嗯，不干。我们有鞋匠、裁缝、泥瓦匠、农夫、医者、工匠、陶匠、养禽的、养蛇的、养龙的……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeGlint1","MYAREA",40)
RESPONSE #40
