// EMILY

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeEmily1","MYAREA",0)
	Switch("C02DrakeEmily1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("X3Emily",~德雷克，你有空吗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~有，不止一点。你在想什么，金发姑娘？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("X3Emily",~我有名字的。我叫艾米莉。总之……你对这整场战争怎么看？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~问当兵的战争的事？这可是个一开口就说不完的问题。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("X3Emily",~我不是在评判。我明白你一定有的责任感。我只是想知道你有没有怀疑。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Drake",~为什么？因为我们的敌人跟我们一样有自己的一套是非？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("X3Emily",~对，那个……正是。你把我要说的说出来了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Drake",~别想太深，金发姑娘。你要真想，就停不下来。这话从一个懂战争的人嘴里出来。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeEmily2","MYAREA",0)
	Switch("C02DrakeEmily2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("X3Emily",~我做不到，德雷克。我怎么能无视伤害那些并不邪恶的人？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~难，是吧？最难打的仗，从来不是跟你恨的人打。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("X3Emily",~我知道我们站在对的一边。我坚持这点，所以我才打。可……我知道我们的敌人一定也这么觉得。我感觉得到。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~可你要让别人替你决定什么是对的，某种意义上，你早就输了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("X3Emily",~你就是这样才能轻松地打起来？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Drake",~我在这儿，是因为我相信反对圣战军是对的选择。跟我作对的那些人只是选错了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Drake",~有时候……错的选择本质上并不总是恶的。这你得接受，并且无论如何都要找到勇气去打。这就是战争。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("X3Emily",~就真没和解的余地？除了让一方毁掉另一方，就没别的路？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Drake",~你哪天找到这问题的答案，金发姑娘……告诉我一声。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02DrakeEmily2","MYAREA",-1)
END

