// Rasaad

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeRasaad1","MYAREA",0)
	Switch("C02DrakeRasaad1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Rasaad",~你很强，德雷克。许多战士太依赖兵器和铠甲，忘了也该锤炼身体。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02DrakeRasaad1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Drake",~我看是。太多骑士只练到能穿着铠甲不摔倒的最低限度，就到此为止。结果那身铠甲不顶用时，他们往往就送了命。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Rasaad",~可你没那么依赖铠甲。我注意到你打起来脚步轻得出人意料。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Drake",~哦，我也没好到哪去。可参与我那份酒馆斗殴有它的好处。没铠甲护着也没铠甲压着，躲拳头和飞来的酒杯就成了好练习。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Rasaad",~那你常干这种事？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Drake",~哦，常得很。我有些最好的朋友就是敲掉他们牙齿认识的。或者被他们敲掉我的牙。比起我们骑士团这些人习惯的体面决斗，这真是提神的变化。没规矩，没荣誉，只有纯粹生猛的混乱。刺激。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Rasaad",~听着确实……不一样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Drake",~你哪天该跟我去。对我们俩都是好练习。更别说好玩。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("Rasaad",~我看我还是算了。不知怎的，这前景看着不……公道。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02DrakeRasaad2","MYAREA",0)
	Switch("C02DrakeRasaad2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Drake",~一个卡林杉算命婆曾对我说，万物皆已前定，其故事早写在命运之书上。你信这种事吗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Rasaad",~要是真的，那意味着我从一开始就注定完了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Drake",~你为什么这么说？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Rasaad",~还不明显？我还是孩子就没了父亲。我用自己的拳头失去了哥哥。我这一生都在面对惨事。那算命的要没说错，那我做的一切都毫无意义。那些惨事本来就注定。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Drake",~就算如此，也不见得意味着你就完了，对吧？也许写着你的幸福那页还没翻过来。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Rasaad",~我只怕我永远读不到它，因为我怀疑我先等来的是自己的死。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Drake",~可要真有那样的故事，那意味着你注定会看到它，你不觉得？我还不会这么轻易放弃。你的故事还没完。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Rasaad",~你也许说得对，德雷克。我真希望如此。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02DrakeRasaad2","MYAREA",-1)
END

