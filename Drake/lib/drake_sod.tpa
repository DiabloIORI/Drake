COPY ~Drake/areas/sod~ ~override~
COPY ~Drake/items/sod~ ~override~

// Journal
ADD_JOURNAL TITLE (@4) @5 @6 USING ~%MOD_FOLDER%/translations/english/journal.tra~
LOAD_TRA ~%MOD_FOLDER%/translations/%LANGUAGE%/journal.tra~
OUTER_SET %Drake_SoD_Recruit_Journal% = RESOLVE_STR_REF (@3)
OUTER_SET %Drake_SoD_Quest_1% = RESOLVE_STR_REF (@5)
OUTER_SET %Drake_SoD_Quest_2% = RESOLVE_STR_REF (@6)
LOAD_TRA ~%MOD_FOLDER%/translations/%LANGUAGE%/setup.tra~

COPY ~Drake/creatures/SoD/C02Drake.cre~ ~override/C02Drake.cre~
  SAY NAME1 ~Drake~
  SAY NAME2 ~Drake~
  WRITE_ASCII 0x248 ~C02Drake~ #8  //override script
  WRITE_ASCII 0x280 ~C0Drake~ #32  //DV
  WRITE_ASCII 0x2cc ~C02Drake~ #8   //pre-joining dialogue file
  WRITE_ASCII 0X34 ~DrakeM~ #8   //small portrait
  WRITE_ASCII 0x3c ~DrakeL~ #8   //medium portrait
  SAY BIO ~有人问起德雷克的过去时，他讥讽地笑一声，回答说要是他的过去被忘掉，历史会呼吸得更顺畅。他是提尔的祭司，三十五六岁，考尔菲尔德家次子，曾是安姆民兵的少尉，说起来还带着一丝自嘲地补充，是光辉之心辅助队的新募。他自认在骑士团里是“他们甩不掉的那号东西”。他坦承自己对骑士团教条和正义分配的非正统看法，让他成了光辉之心同袍和家里人眼里的社会弃儿，而他家人几乎个个都有在骑士团服役的履历。据他说，他驻在安姆之外，官方说法是去铲除祸害剑湾的邪恶，可他相信那不过是把他打发走、让上司忘掉他的正式手段。不过这样的差事似乎正合他意，因为他相信正义最好用刀刃来施行——或者，在他这儿，用锤头。
  
  德雷克本打算在铁危机了结后回安姆，可光明女士的圣战军之威胁让他有理由留在博德之门，参加进军龙矛的行列。他似乎急着弄清圣战军存在的缘由。~
  SAY MORALE ~跟这家伙再打下去没道理了！~ [C0DR001]
  SAY HAPPY ~不错，不错。你够跟任何骑士较量的。~ [C0DR002]
  SAY UNHAPPY_ANNOYED ~这回我先往好处想，可你自己当心。~ [C0DR003]
  SAY UNHAPPY_SERIOUS ~你要么是糊涂得没救了，要么是烂得没救了。我祈祷你是前者。~ [C0DR004]
  SAY UNHAPPY_BREAKING_POINT ~够了。我得喝不止几杯才能忘掉我看到的。下回再见，我先动锤子。~ [C0DR005]
  SAY LEADER ~这事你问错人了。认真的？你最好别后悔。~ [C0DR006]
  SAY TIRED ~这会儿我还有什么不肯换个烈酒和软床的……~ [C0DR007]
  SAY BORED ~我快憋尿憋出来了，跟当年在骑士团当班站桩一样。我们能不能走快些？~ [C0DR008]
  SAY BATTLE_CRY1 ~我要亲手把你送上审判！~ [C0DR009]
  SAY BATTLE_CRY2 ~你不过是个还在走路的死人！~ [C0DR010]
  SAY BATTLE_CRY3 ~趁还能，把祷词念了吧！~ [C0DR011]
  SAY BATTLE_CRY4 ~这杯算我的！~ [C0DR012]
  SAY BATTLE_CRY5 ~我的锤子等着亲你屁股！~ [C0DR013]
  SAY DAMAGE ~哎哟！~ [C0DR014]
  SAY DYING ~呃……该死……~ [C0DR015]
  SAY HURT ~啊……你就这点本事？~ [C0DR016]
  SAY AREA_FOREST ~早知道要在林子里跋涉，我就该穿双结实点的靴子。~ [C0DR017]
  SAY AREA_CITY ~小贩、臭气、便宜麦酒。正合我意。~ [C0DR018]
  SAY AREA_DUNGEON ~脚下留神。傻子才冲进天使都不敢踏的地方。~ [C0DR019]
  SAY AREA_DAY ~太阳照在我们头顶，我又想起我的铠甲还得擦。~ [C0DR020]
  SAY AREA_NIGHT ~我们本可以在暖和的旅店里喝醉，而不是在黑暗里笨重地走……~ [C0DR021]
  SAY SELECT_COMMON1 ~嗯？~ [C0DR022]
  SAY SELECT_COMMON2 ~有事吗？~ [C0DR023]
  SAY SELECT_COMMON3 ~下命令吧。~ [C0DR024]
  SAY SELECT_ACTION1 ~当然，当然。~ [C0DR028]
  SAY SELECT_ACTION2 ~简单得很。~ [C0DR029]
  SAY SELECT_ACTION3 ~我们走。~ [C0DR030]
  SAY CRITICAL_HIT ~哈！看来天平偏*我*这边！~ [C0DR037]
  SAY CRITICAL_MISS ~啧……没人看见。~ [C0DR038]	
  SAY TARGET_IMMUNE ~没效果？这可没料到。~ [C0DR039]
  SAY INVENTORY_FULL ~这破烂我得有两只以上的手才拿得住。找别人去搬。~ [C0DR040]
  SAY SPELL_DISRUPTED ~该死的！~ [C0DR041]
  SAY SET_A_TRAP ~我同情那踩上这玩意儿的可怜混蛋。~ [C0DR042]
  SAY HIDDEN_IN_SHADOWS ~该试试潜行了。~ [C0DR043]
  SAY PICKED_POCKET ~不太像骑士，可没人需要知道，对吧？~ [C0DR044]
  WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~OHTYR~))

APPEND ~bddialog.2da~ ~C0Drake C02DrakP C02DrakJ C02DrakD~
  UNLESS ~C0Drake~
  
