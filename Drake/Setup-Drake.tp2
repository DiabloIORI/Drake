BACKUP ~weidu_external/backup/Drake_BG1~
AUTHOR ~The Artisan~
ALWAYS
  INCLUDE ~%MOD_FOLDER%/lib/eet.tph~
  INCLUDE ~%MOD_FOLDER%/lib/functions.tph~
  INCLUDE ~%MOD_FOLDER%/lib/alter_script.tpa~
END
AUTO_TRA ~Drake/translations/%s~
LANGUAGE ~English~
         ~English~
         ~Drake/translations/english/Drake.tra~

  BEGIN ~德雷克 NPC（博德之门：增强版）~
  REQUIRE_PREDICATE (GAME_IS ~bgee eet~) ~本组件须安装在 BG:EE 上。~

ACTION_IF GAME_IS ~BGEE~ THEN BEGIN
INCLUDE ~%MOD_FOLDER%/lib/liam_bgee_vars.tpa~
OUTER_SPRINT "bg1_eet_symbol" AR
END

ACTION_IF GAME_IS ~EET~ THEN BEGIN
INCLUDE ~EET/other/cpmvars/eet_cpmvars.tpa~
OUTER_SPRINT "bg1_eet_symbol" BG
END

INCLUDE ~%MOD_FOLDER%/lib/drake_bg1.tpa~
ACTION_IF GAME_INCLUDES ~sod~
THEN BEGIN
  PRINT ~正在安装龙矛围城相关内容……~
INCLUDE ~%MOD_FOLDER%/lib/drake_sod.tpa~
END

BEGIN ~默认肖像（The Artisan）~
FORCED_SUBCOMPONENT ~为德雷克选择肖像：~
  REQUIRE_COMPONENT ~Setup-Drake.tp2~ ~0~ ~必须先安装主组件。~
  REQUIRE_PREDICATE (GAME_IS ~bgee eet~) ~本组件须安装在 BG:EE 或 EET 上。~
		COPY ~%MOD_FOLDER%/portraits/DrakeL.bmp~ ~override/DrakeL.bmp~
		COPY ~%MOD_FOLDER%/portraits/DrakeM.bmp~ ~override/DrakeM.bmp~
		COPY ~%MOD_FOLDER%/portraits/DrakeS.bmp~ ~override/DrakeS.bmp~
		
BEGIN ~BG2 风格肖像（The Artisan）~
FORCED_SUBCOMPONENT ~为德雷克选择肖像：~
  REQUIRE_COMPONENT ~Setup-Drake.tp2~ ~0~ ~必须先安装主组件。~
  REQUIRE_PREDICATE (GAME_IS ~bgee eet~) ~本组件须安装在 BG:EE 或 EET 上。~
		COPY ~%MOD_FOLDER%/portraits/Drake2.bmp~ ~override/DrakeL.bmp~
		COPY ~%MOD_FOLDER%/portraits/Drake2.bmp~ ~override/DrakeM.bmp~
		COPY ~%MOD_FOLDER%/portraits/Drake2.bmp~ ~override/DrakeS.bmp~
		
BEGIN ~测试版肖像（Lava Del'Vortel）~
FORCED_SUBCOMPONENT ~为德雷克选择肖像：~
  REQUIRE_COMPONENT ~Setup-Drake.tp2~ ~0~ ~必须先安装主组件。~
  REQUIRE_PREDICATE (GAME_IS ~bgee eet~) ~本组件须安装在 BG:EE 或 EET 上。~
		COPY ~%MOD_FOLDER%/portraits/Drake.bmp~ ~override/DrakeL.bmp~
		COPY ~%MOD_FOLDER%/portraits/Drake.bmp~ ~override/DrakeM.bmp~
		COPY ~%MOD_FOLDER%/portraits/Drake.bmp~ ~override/DrakeS.bmp~
		
BEGIN ~可选：安装通用弩，并让德雷克获得弩械熟练？~

INCLUDE ~%MOD_FOLDER%/lib/crossbows.tpa~

BEGIN ~可选：BillyYank 制作的原始语音包~


LAF HANDLE_AUDIO 
STR_VAR
    audio_path = ~Drake/audio/original~
    oggdec_path = ~Drake/audio~
	END

COPY_EXISTING ~C0Drake.cre~ ~override/C0Drake.cre~
  SAY MORALE ~他们说审慎是勇武的更重要一半。~ [C0DRA001]
  SAY HAPPY ~嗯，不错，不错。连骑士团那些家伙都能学个一两手。~ [C0DRA002]
  SAY UNHAPPY_ANNOYED ~你真确定你知道自己在九层地狱的名义下干什么吗？~ [C0DRA003]
  SAY UNHAPPY_SERIOUS ~我分不清你是糊涂得没救，还是……你真比我更喜欢让人恨你。不管哪样，我建议你停手。~ [C0DRA004]
  SAY UNHAPPY_BREAKING_POINT ~够了。我看就算把自己灌到不省人事，也不够让我无视这一堆胡话。下回再见，我先动锤子。你下地狱去吧。~ [C0DRA005]
  SAY LEADER ~嘿，这么说现在我是头儿了，对吧？真想知道骑士团那些老家伙看到我现在这样会怎么想……希望你别后悔。~ [C0DRA006]
  SAY TIRED ~提尔的屁股啊，这会儿我有什么不肯换个暖火和一杯烈酒……~ [C0DRA007]
  SAY BORED ~这么站着等就跟当年在骑士团当班站桩一样，连无聊都一模一样。我们能不能走快点？~ [C0DRA008]
  SAY BATTLE_CRY1 ~我要让你见识真正的正义！~ [C0DRA009]
  SAY BATTLE_CRY2 ~你的判决就在这儿！~ [C0DRA010]
  SAY BATTLE_CRY3 ~最好趁还能，把祷词念了吧。~ [C0DRA011]
  SAY BATTLE_CRY4 ~我的锤子和靴子都等着亲你屁股！~ [C0DRA012]
  SAY BATTLE_CRY5 ~那可怜虫不过是个还在走路的死人。~ [C0DRA013]
  SAY DAMAGE ~哎哟！~ [C0DRA014]
  SAY DYING ~呃，真……丢人。~ [C0DRA015]
  SAY HURT ~啊……我虽然想见提尔，可我看他不会这么早乐意审判我的屁股。能不能……搭把手？~ [C0DRA016]
  SAY AREA_FOREST ~早知道要在林子里跋涉，我就该穿双结实点的靴子。~ [C0DRA017]
  SAY AREA_CITY ~沟里那股麦酒和发酸呕吐物的味儿挺亲切，你不觉得？~ [C0DRA018]
  SAY AREA_DUNGEON ~哈……我倒想祈祷，可我看我们现在这地方，连神也听不见。~ [C0DRA019]
  SAY AREA_DAY ~今天倒是个发落判决的好日子，你不觉得？~ [C0DRA020]
  SAY AREA_NIGHT ~最下等的渣滓在黑暗里活得滋润……我随时准备好把他们摆正。~ [C0DRA021]
  SAY SELECT_COMMON1 ~嗯？~ [C0DRA022]
  SAY SELECT_COMMON2 ~有事吗？~ [C0DRA023]
  SAY SELECT_COMMON3 ~我听着。~ [C0DRA024]
  SAY SELECT_COMMON4 ~下命令吧。~ [C0DRA025]
  SAY SELECT_COMMON5 ~什么事？~ [C0DRA026]
  SAY SELECT_COMMON6 ~有话要说？~ [C0DRA027]
  SAY SELECT_ACTION1 ~好，好。~ [C0DRA028]
  SAY SELECT_ACTION2 ~简单得很。~ [C0DRA029]
  SAY SELECT_ACTION3 ~如你所说，朋友。~ [C0DRA030]
  SAY SELECT_ACTION4 ~你到底给不给我点事做？~ [C0DRA031]
  SAY SELECT_ACTION5 ~你这回又怎么了？断胳膊断腿？~ [C0DRA032]
  SAY SELECT_ACTION6 ~请安静……我头快炸了。~ [C0DRA033]
  SAY SELECT_ACTION7 ~你还欠我好几杯酒呢，你知道吧。~ [C0DRA034]
  SAY CRITICAL_HIT ~哈！看来天平偏*我*这边！~ [C0DRA035]
  SAY CRITICAL_MISS ~啧……！你什么都没看见。~ [C0DRA036]
  SAY TARGET_IMMUNE ~一点擦伤都没有？哎呀，这可有点意思。~ [C0DRA037]
  SAY INVENTORY_FULL ~怕是两只手都不够搬这坨破烂。找别人去拿。~ [C0DRA038]
  SAY SPELL_DISRUPTED ~这回祈祷搞砸了可不怪我。~ [C0DRA039]
  SAY SET_A_TRAP ~这够让下一个混蛋好好吃一惊。~ [C0DRA040]
  SAY HIDDEN_IN_SHADOWS ~没人料到正义会从阴影里来。~ [C0DRA041]
  SAY PICKED_POCKET ~哎哟……你把这个掉了。~ [C0DRA042]
  
